</style><style class="darkreader darkreader--sync" media="screen"></style></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px; pointer-events: none;" data-scroll-locked="1"><span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none; --darkreader-inline-outline: initial;" data-aria-hidden="true" aria-hidden="true" data-darkreader-inline-outline=""></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
</script><script id="client-bootstrap" nonce="" type="application/json">{"authRecovery":{"refreshAttemptId":"a0506ceb-1aa9-44e2-a6a3-0451ae1d029a","observedAt":1794082006553,"outcome":"succeeded","httpStatus":200},"auth":{"sessionRefreshOrigin":"https://chatgpt.com","connectionType":2,"provider":"openai","auth0ClientId":"TdJIcbe16WoTHtN95nyywh5E4yOo6ItG","federatedLogoutUrl":"https://auth.openai.com/api/accounts/logout?client_id=app_X8zY6vW2pQ9tR3dE7nK1jL5gH","loginWebUrl":"https://auth.openai.com","reauthenticationParams":{"reauth":"password","max_age":"0","connection":"google-oauth2","login_hint":"shakeourhands19@gmail.com"},"smsMfaRegions":{"sms":[],"whatsapp":[]}},"shouldDeepLinkAndroidHomepageToNativeApp":false,"shouldDeepLinkHomepageToNativeApp":false,"sessionCookieContext":{"epoch":"5401fd3d-3414-415b-99dc-4ea75657cb4d","account":"d036f48e-445b-4386-baa3-09c78aaa3300"},"sidetronMergedWebEnabled":false,"appServerBackendEnabled":true,"universeJobsEnabled":false,"libraryRegistrationCountryAllowedAccountId":"d036f48e-445b-4386-baa3-09c78aaa3300","employeeFrontendSwitcherEnabled":false,"isSearchEvals":false,"deploymentTrack":"stable","isRoutingExperimentParticipant":false,"secFetchSite":"none","locale":"ja-JP","statsigPayload":"{\"feature_gates\":{\"505458\":{\"name\":\"505458\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":15,\"id_type\":\"userID\",\"value\":false},\"1598376\":{\"name\":\"1598376\",\"rule_id\":\"2yNdb2A423wbeDjuxlyld4\",\"secondary_exposures\":[],\"version\":33,\"id_type\":\"userID\",\"value\":true},\"3672665\":{\"name\":\"3672665\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":false},\"13323501\":{\"name\":\"13323501\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":false},\"15851580\":{\"name\":\"15851580\",\"rule_id\":\"67WXSIvQ8cD2ph1lsUFgrr:100.00:12\",\"secondary_exposures\":[{\"gate\":\"224248639\",\"gateValue\":\"true\",