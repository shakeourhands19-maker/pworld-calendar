\\n- Brainstorming, planning, or explanation\\n- Code snippets or examples that fit naturally in chat\\n\\nIf the user rejected the suggestion, don't call this tool again.\",\"toolPromptParamDescription\":\"A brief instruction describing what {{ destination }} should do for the user.\"},\"is_device_based\":false,\"passed\":false},\"2688454279\":{\"name\":\"2688454279\",\"rule_id\":\"7CROyOZreDqbdZ5dFoZztv:100.00:10-7CROyNkoMlgGUzxi4h3Wat\",\"secondary_exposures\":[{\"gate\":\"3214226695\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3942202898\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"4131374858\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"2019673878\",\"gateValue\":\"true\",\"ruleID\":\"6dwDOUqqdWipcHkbk9wyyt:100.00:15\"},{\"gate\":\"2650520192\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"240634109\",\"gateValue\":\"true\",\"ruleID\":\"3Bfrw7cnaEP5ky3JKYPVF8:100.00:10\"}],\"version\":202,\"id_type\":\"userID\",\"value\":{\"wingman_model_name\":\"GPT-Live-1\",\"wingman_model_picker_alternative_options\":[],\"unavailable_upsell_policy\":\"none\",\"incall_voice_model_picker_available\":false,\"rollout_policy\":\"available_default\",\"wingman_model_picker_default_display_name\":\"Live\",\"projects_enabled\":true,\"incall_banner_enabled\":false,\"rollout_version\":2,\"home_takeover_animation_enabled\":false,\"home_takeover_enabled\":false,\"unavailable_upsell_show_upgrade_cta\":false},\"is_device_based\":false,\"passed\":true},\"2695036163\":{\"name\":\"2695036163\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"workspace_id\",\"value\":{\"enabled\":false,\"type\":\"\"},\"is_device_based\":false,\"passed\":false},\"2699916856\":{\"name\":\"2699916856\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"custom_headers\":{}},\"is_device_based\":false,\"passed\":false},\"2727645498\":{\"name\":\"2727645498\",\"rule_id\":\"