 CTA\"},{\"key\":\"product_card_v2_single\",\"label\":\"ProductCardV2: Single\"},{\"key\":\"product_card_v2_single_with_preamble\",\"label\":\"ProductCardV2: Single with Preamble\"},{\"label\":\"ProductCardV2: Two Horizontal\",\"key\":\"product_card_v2_two_horizontal\"},{\"label\":\"ProductCardV2: Two Vertical\",\"key\":\"product_card_v2_two_vertical\"},{\"label\":\"ProductCardV2: Four\",\"key\":\"product_card_v2_four\"},{\"key\":\"product_card_v2_four_compact\",\"label\":\"ProductCardV2: Four Compact\"},{\"key\":\"product_card_v2_four_compact_medium\",\"label\":\"ProductCardV2: Four Compact Medium\"},{\"key\":\"product_card_v2_four_with_preamble\",\"label\":\"ProductCardV2: Four with Preamble\"},{\"label\":\"ProductCardV2: Five\",\"key\":\"product_card_v2_five\"},{\"key\":\"product_card_v2_temu_1\",\"label\":\"Temu 1\"},{\"label\":\"Temu 2\",\"key\":\"product_card_v2_temu_2\"},{\"label\":\"Temu 3\",\"key\":\"product_card_v2_temu_3\"},{\"label\":\"Personalized Ads MVP 1\",\"key\":\"image_card_v2_personalized_ads_mvp_1\"},{\"key\":\"image_card_v2_personalized_ads_mvp_2\",\"label\":\"Personalized Ads MVP 2\"},{\"key\":\"test_agent_5\",\"label\":\"Dogfood business agent\"},{\"key\":\"expedia_business_agent\",\"label\":\"Expedia - Business Agent\"},{\"key\":\"expedia_prod_agent\",\"label\":\"Expedia Prod Agent\"},{\"label\":\"Homh Prod Agent\",\"key\":\"homh_prod_agent\"},{\"key\":\"wayfair_prod_agent\",\"label\":\"Wayfair Prod Agent\"},{\"key\":\"wayfair_prod_agent_dual_cta\",\"label\":\"Wayfair Agent — Product Carousel (chat CTA)\"},{\"label\":\"Pottery Barn Prod Agent\",\"key\":\"pottery_barn_prod_agent\"},{\"key\":\"shop_prod_agent\",\"label\":\"Shop Prod Agent\"},{\"key\":\"answering_service_prod_agent\",\"label\":\"Answering Service Care Prod Agent\"},{\"key\":\"spellbook_prod_agent\",\"label\":\"Spellbook Prod Agent\"},{\"label\":\"Booking.com Prod Agent\",\"key\":\"booking_prod_agent\"},{\"label\":\"Hilton Prod Agent\",\"key\":\"hilton_prod_agent\"},{\"label\":\"GEICO Prod Agent\",\"key\":\"geico_prod_agent\"},{\"key\":\"legalzoom_prod_agent\",\"label\":\"LegalZoom Prod Agent\"},{\"label\":\"The Feed Prod Agent\",\"key\":\"the_feed_prod_agent\"},{\"key\":\"brilliant_earth_prod_agent\",\"label\":\"Brilliant Earth Prod Agent\"},{\"key\":\"angi_prod_agent\",\"label\":\"Angi Prod Agent\"},{\"key\":\"shopify_smb_prod_agent\",\"label\":\"Shopify SMB Prod Agent\"},{\"key\":\"shopify_smb_prod_agent_dual_cta\",\"label\":\"Shopify SMB Agent — Dual CTA (icons)\"},{\"label\":\"Canva Print Prod Agent\",\"key\":\"canva_print_prod_agent\"},{\"label\":\"Budget Direct Prod Agent\",\"key\":\"budget_direct_prod_agent\"},{\"key\":\"lowes_prod_agent\",\"label\":\"Lowes Prod Agent\"},{\"label\":\"Personalized: Composer Pinned (Server)\",\"key\":\"image_card_v2_personalized_ads_mvp_2_composer_pinned\"},{\"label\":\"Pending: Carousel 1:1 — 4 images\",\"key\":\"pending_carousel_square\"},{\"label\":\"Pending: Slideshow 16:9 — 4 images\",\"key\":\"pending_slideshow_landscape\"},{\"key\":\"pending_slideshow_landscape_collapse_on_image_completion\",\"label\":\"Pending: Slideshow 16:9 — 4 images (collapse after image generation, iOS)\"},{\"key\":\"travel_feed_carousel\",\"label\":\"Travel Feed: Variant A — Rating on image\"},{\"key\":\"travel_feed_variant_b\",\"label\":\"Travel Feed: Variant B — Title and price\"},{\"key\":\"travel_feed_variant_c\",\"label\":\"Travel Feed: Variant C — Rating below title\"},{\"key\":\"travel_feed_single\",\"label\":\"Travel Feed: Single hotel\"},{\"key\":\"travel_feed_ten_point\",\"label\":\"Travel Feed: Ten-point rating\"},{\"key\":\"travel_feed_sparse_metadata\",\"label\":\"Travel Feed: Sparse metadata\"},{\"label\":\"Pending: Image Card V2 — Single\",\"key\":\"pending_image_card_v2_single\"},{\"label\":\"Pending: Image Card V2 — Single (collapse after image generation, iOS)\",\"key\":\"pending_image_card_v2_single_collapse_on_image_completion\"},{\"label\":\"Pending: Product Card V2 — Single\",\"key\":\"pending_product_card_v2_single\"},{\"key\":\"pending_product_carousel\",\"label\":\"Pending: Compact Product Carousel — No price\"},{\"label\":\"Pending: Slideshow 16:9 — 4 images (Auto-scroll)\",\"key\":\"pending_slideshow_landscape_auto_scroll\"},{\"label\":\"Conversation Bottom: Slideshow 1:1 — 1 image\",\"key\":\"conversation_bottom_slideshow_square_single\"},{\"label\":\"ImageCardV2: Native — Preamble\",\"key\":\"previous_ad_native_image_preamble\"},{\"label\":\"ImageCardV2: Native — Keep visible on next send\",\"key\":\"previous_ad_native_image_keep_visible\"},{\"label\":\"GEICO Test Agent\",\"key\":\"geico_test_agent\"},{\"label\":\"ImageCardV2: Single — One-line subtitle\",\"key\":\"image_card_v2_single_one_line\"}]},\"is_device_based\":false,\"passed\":false},\"1122994996\":{\"name\":\"1122994996\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"schemaVersion\":1,\"templates\":[{\"id\":\"product-strategy\",\"title\":\"Product Strategy\",\"revision\":\"c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/cover.png\",\"publisher\":\"openai\",\"source\":{\"format\":\"presentation-protobuf\",\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/product-strategy/c98a598ca5cbf03c29c276219182769ab676c32033bde9db71dd2c205624d721/presentation.pb\",\"sha256\":\"752ddf9ebb318c4a11e37373dbf053e6450336b9ed45a62eacf4d042f51c6eae\",\"byteLength\":410320}},{\"title\":\"Weekly Business Review\",\"id\":\"weekly-business-review\",\"publisher\":\"openai\",\"source\":{\"sha256\":\"205ca471d698cf2b4037cd9bedadabb7e8eabc87c130e4769b0a81257408c03e\",\"format\":\"presentation-protobuf\",\"byteLength\":245283,\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/weekly-business-review/28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750/presentation.pb\"},\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/weekly-business-review/28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750/cover.png\",\"revision\":\"28b9e7ae1f36383f5b9079f13744a190972ddb1c6266663789584d53c37dc750\"},{\"source\":{\"sha256\":\"b4b228b4ed45654348513b40a2a41a16612fedc1ce0d0317379a34e22813149c\",\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/photography-portfolio/5d8abc9c361cd00c938b1b18aaf8ec2f731afea409eb23a17b823cdca6d1111e/presentation.pb\",\"byteLength\":2841567,\"format\":\"presentation-protobuf\"},\"id\":\"photography-portfolio\",\"title\":\"Photography Portfolio\",\"publisher\":\"openai\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/photography-portfolio/5d8abc9c361cd00c938b1b18aaf8ec2f731afea409eb23a17b823cdca6d1111e/cover.png\",\"revision\":\"5d8abc9c361cd00c938b1b18aaf8ec2f731afea409eb23a17b823cdca6d1111e\"},{\"publisher\":\"openai\",\"revision\":\"dfeb93f63d1ceac1800672188710b9c1e96540885cfece7469f2423797ee0157\",\"id\":\"next-generation-os\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/next-generation-os/dfeb93f63d1ceac1800672188710b9c1e96540885cfece7469f2423797ee0157/cover.png\",\"source\":{\"format\":\"presentation-protobuf\",\"byteLength\":2246549,\"sha256\":\"17b87f4448636f4bc8587fae0c249f8c2fd3d635b2e7d289c944dce0ccf1b36f\",\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/next-generation-os/dfeb93f63d1ceac1800672188710b9c1e96540885cfece7469f2423797ee0157/presentation.pb\"},\"title\":\"Next Generation OS\"},{\"revision\":\"f21edd20278d772ca50b6ab8b4c2f975da263e187db607a12daf5e2360e11cf5\",\"id\":\"brand-guidelines\",\"source\":{\"sha256\":\"31907bd5adf017edddf512080c2cef1ad8f48bad196b7e4913670018e53764e8\",\"byteLength\":881017,\"format\":\"presentation-protobuf\",\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/br