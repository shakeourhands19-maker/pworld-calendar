// Hydration preserves this seed until AppearanceProvider takes over.
/** @param {string} browserThemeCacheKey */
// oxlint-disable-next-line no-unused-vars -- The raw source is called by browser-theme-bootstrap.ts when constructing the inline script.
function initializeBrowserTheme(browserThemeCacheKey) {
  const root = document.documentElement;
  const preference = root.dataset.appearanceMode;
  if (preference === "light" || preference === "dark") {
    root.dataset.theme = preference;
  } else {
    root.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";
  }
  try {
    const themes = JSON.parse(
      window.localStorage.getItem(browserThemeCacheKey),
    );
    const mode = themes?.[root.dataset.theme];
    if (
      typeof themes?.css === "string" &&
      (typeof mode === "boolean" ||
        (typeof mode?.preset === "string" &&
          typeof mode.chatGpt === "boolean")) &&
      // The origin-wide cache may belong to a different user or workspace.
      themes.accountId === (root.dataset.themeAccountId ?? null) &&
      themes.userId === (root.dataset.themeUserId ?? null)
    ) {
      document.querySelector("style[data-codex-app-themes]").textContent =
        root.dataset.theme === themes.variant
          ? themes.css
          : (themes.alternateCss ?? themes.css);
      if (typeof mode !== "boolean") {
        root.dataset.appearancePreset = mode.preset;
      }
      root.classList.toggle(
        "chatgpt-theme",
        typeof mode === "boolean" ? mode : mode.chatGpt === true,
      );
    }
  } catch {
    // Unavailable storage or an invalid cache leaves the default palette intact.
  }
}

initializeBrowserTheme("codex.browser.appThemes.v1");})();</script><script async="" src="./08_files/api.js.ダウンロード"></script><link rel="stylesheet" type="text/css" href="./08_files/75cba688087f.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/3ac82d8d572d.css"><style class="darkreader darkreader--sync" media="screen"></style><style data-glasp-print="rule">@media print{[data-glasp-print="hide"]{display:none !important}}</style><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/4c8ac7e0ca15.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/c28a1f012177.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/23917e9a2cc5.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/5ead353af714.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/1b2c43437733.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/225b7e817ac3.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/195535ba27b4.css"><style class="darkreader darkreader--sync" media="screen"></style><link rel="stylesheet" type="text/css" href="./08_files/f813678c40c7.css"><style class="darkreader darkreader--sync" media="screen"></style><meta http-equiv="origin-trial" content="AnY33Lstn7fSTXvj63Z4glPcRXtUukuM9rLN87JGOugFyfum9ckNUU3NYHeRLcp6TELT5wbCZih5SlHfumMbJAkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTc5NDg3MzYwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/cs