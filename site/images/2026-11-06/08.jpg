alue\":false},\"4263582812\":{\"name\":\"4263582812\",\"rule_id\":\"5pW1Ahs6X3XDmFetGcRpi3:100.00:2\",\"secondary_exposures\":[],\"version\":48,\"id_type\":\"userID\",\"value\":true},\"4283773748\":{\"name\":\"4283773748\",\"rule_id\":\"4YP1U57YAYRtt8V1r2VKeb\",\"secondary_exposures\":[],\"version\":24,\"id_type\":\"userID\",\"value\":false},\"4285716042\":{\"name\":\"4285716042\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":57,\"id_type\":\"userID\",\"value\":false},\"4290031608\":{\"name\":\"4290031608\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":86,\"id_type\":\"userID\",\"value\":false}},\"dynamic_configs\":{\"24353602\":{\"name\":\"24353602\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":28,\"id_type\":\"userID\",\"value\":{\"fr\":{\"business_claim\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Connectez-vous au compte que vous utilisez pour votre espace de travail Business.\"},\"personal\":{\"body\":\"Découvrez l’offre pour votre équipe. Vous utilisez déjà ChatGPT Business ? Accédez à votre espace de travail.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"default\":{\"body\":\"En savoir plus sur les crédits publicitaires destinés aux espaces de travail éligibles.\",\"headline\":\"Découvrez ChatGPT Business\"},\"workspace_owner\":{\"headline\":\"Consultez les avantages de votre espace de travail\",\"body\":\"Ouvrez la rubrique « Avantages » pour voir si votre espace de travail est éligible aux crédits publicitaires.\"},\"workspace_admin\":{\"headline\":\"Aidez votre équipe à trouver des crédits publicitaires\",\"body\":\"Demandez à un propriétaire de l’espace de travail de consulter l’offre de crédits publicitaires dans la rubrique « Avantages ».\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"Si votre espace de travail est éligible, un propriétaire peut demander des crédits publicitaires dans la rubrique « Avantages ». Pour créer un espace de travail Business distinct, sélectionnez « Continuer ».\"},\"personal_upsell\":{\"body\":\"Découvrez ChatGPT Business et l’offre de crédits publicitaires destinée aux espaces de travail éligibles.\",\"headline\":\"Passez à ChatGPT Business avec votre équipe\"},\"workspace\":{\"headline\":\"Découvrez les crédits publicitaires pour votre espace de travail\",\"body\":\"Un propriétaire de l’espace de travail peut consulter les offres disponibles dans la rubrique « Avantages ».\"}},\"en\":{\"personal\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore the offer for your team. Already use Business? Switch to your workspace.\"},\"default\":{\"headline\":\"Explore ChatGPT Business\",\"body\":\"Learn about ad credits for eligible workspaces.\"},\"workspace\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"A workspace owner can check Benefits for available offers.\"},\"workspace_admin\":{\"body\":\"Ask a workspace owner to check Benefits for the ad credit offer.\",\"headline\":\"Help your team find ad credits\"},\"workspace_member\":{\"headline\":\"ChatGPT Business\",\"body\":\"If your workspace is eligible, an owner can claim ad credits in Benefits. To set up a separate Business workspace, select Continue.\"},\"personal_upsell\":{\"headline\":\"Bring your team to Business\",\"body\":\"Explore ChatGPT Business and the ad credit offer for eligible workspaces.\"},\"workspace_owner\":{\"body\":\"Open Benefits to see whether your workspace is eligible for ad credits.\",\"headline\":\"Check your workspace benefits\"},\"business_claim\":{\"headline\":\"Explore workspace ad credits\",\"body\":\"Sign in to the account you use for your Business workspace.\"}},\"email_selectors\":{\"business_claim\":\"workspace\",\"personal_upsell\":\"personal\",\"parameter\":\"for\"},\"de\":{\"personal_upsell\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke ChatGPT Business und das Angebot für Werbeguthaben für berechtigte Workspaces.\"},\"workspace_admin\":{\"headline\":\"Hilf deinem Team, Werbeguthaben zu finden\",\"body\":\"Bitte einen Workspace-Inhaber, unter „Vorteile“ nach dem Angebot für Werbeguthaben zu sehen.\"},\"business_claim\":{\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\",\"body\":\"Melde dich mit dem Konto an, das du für deinen Business-Workspace verwendest.\"},\"workspace\":{\"body\":\"Workspace-Inhaber können unter „Vorteile“ nach verfügbaren Angeboten sehen.\",\"headline\":\"Entdecke Werbeguthaben für deinen Workspace\"},\"personal\":{\"headline\":\"Wechsle mit deinem Team zu ChatGPT Business\",\"body\":\"Entdecke das Angebot für dein Team. Nutzt du ChatGPT Business bereits? Wechsle zu deinem Workspace.\"},\"workspace_member\":{\"body\":\"Wenn dein Workspace berechtigt ist, kann ein Workspace-Inhaber unter „Vorteile“ Werbeguthaben anfordern. Wähle „Weiter“, um einen separaten Business-Workspace einzurichten.\",\"headline\":\"ChatGPT Business\"},\"default\":{\"body\":\"Erfahre mehr über Werbeguthaben für berechtigte Workspaces.\",\"headline\":\"Entdecke ChatGPT Business\"},\"workspace_owner\":{\"body\":\"Öffne „Vorteile“, um zu prüfen, ob dein Workspace für Werbeguthaben berechtigt ist.\",\"headline\":\"Prüfe die Vorteile deines Workspaces\"}}},\"is_device_based\":false,\"passed\":false},\"43735283\":{\"name\":\"43735283\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"4076966226\",\"gateValue\":\"true\",\"ruleID\":\"3Qrg0sazMu3KFYQ5vbybKp:100.00:12\"}],\"version\":33,\"id_type\":\"userID\",\"value\":{\"sentinel_timeout_ms\":250,\"text_messaging_enabled\":\"disabled\"},\"is_device_based\":false,\"passed\":false},\"71832722\":{\"name\":\"71832722\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/concepts/sandboxing\"},\"is_device_based\":false,\"passed\":false},\"73506792\":{\"name\":\"73506792\",\"rule_id\":\"default\",\"secondary_exposur