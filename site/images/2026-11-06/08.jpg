}</style><style class="darkreader darkreader--text" media="screen"></style><style class="darkreader darkreader--user-agent" media="screen">@layer darkreader {
html {
    background-color: var(--darkreader-background-ffffff, #3a3c3d) !important;
}
html {
    color-scheme: dark !important;
}
iframe {
    color-scheme: dark !important;
}
html, body {
    background-color: var(--darkreader-background-ffffff, #3a3c3d);
}
html, body {
    border-color: var(--darkreader-border-4c4c4c, #878075);
    color: var(--darkreader-text-000000, #e9e7e5);
}
a {
    color: var(--darkreader-text-0040ff, #51a0fc);
}
table {
    border-color: var(--darkreader-border-808080, #6d7375);
}
mark {
    color: var(--darkreader-text-000000, #e9e7e5);
}
::placeholder {
    color: var(--darkreader-text-a9a9a9, #bcb6ad);
}
input:-webkit-autofill,
textarea:-webkit-autofill,
select:-webkit-autofill {
    background-color: var(--darkreader-background-faffbd, #5c5f26) !important;
    color: var(--darkreader-text-000000, #e9e7e5) !important;
}
* {
    scrollbar-color: var(--darkreader-background-b0b0b0, #606467) var(--darkreader-background-f1f1f1, #414444);
}
::selection {
    background-color: var(--darkreader-background-0060d4, #2667b5) !important;
    color: var(--darkreader-text-ffffff, #e9e7e5) !important;
}
::-moz-selection {
    background-color: var(--darkreader-background-0060d4, #2667b5) !important;
    color: var(--darkreader-text-ffffff, #e9e7e5) !important;
}
